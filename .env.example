# Copia este archivo a .env.local y rellena los valores reales.
# .env.local NUNCA se sube a git.

# Conexión a Postgres. El schema (?schema=...) se aplica vía search_path.
DATABASE_URL="postgresql://usuario:password@host:5432/basededatos?schema=evaluacionados"

# OpenAI — calificación de preguntas abiertas y generación del feedback.
OPENAI_API_KEY="sk-proj-..."
OPENAI_MODEL="gpt-4.1-mini"

# Firma de la cookie de sesión.
SESSION_SECRET="cambia-esto-en-produccion"

# Correo SMTP (Google Workspace). SMTP_PASS = contraseña de aplicación de Google.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="notificaciones@tudominio.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
MAIL_FROM="Speak Easy <notificaciones@tudominio.com>"
